    </Groups>
    <Buttons>
      <Button guid="guidSLCopilotCommandSet" id="cmdidOpenChat" priority="0x0100" type="Button">
        <Parent guid="guidSLCopilotCommandSet" id="ToolsMenuGroup" />
        <Strings><ButtonText>SLCopilot: 打开聊天</ButtonText></Strings>
      </Button>
      <Button guid="guidSLCopilotCommandSet" id="cmdidAttachSelection" priority="0x0101" type="Button">
        <Parent guid="guidSLCopilotCommandSet" id="ToolsMenuGroup" />
        <Strings><ButtonText>SLCopilot: 附加选区 / 插入点</ButtonText></Strings>
      </Button>
      <Button guid="guidSLCopilotCommandSet" id="cmdidExplainSelection" priority="0x0100" type="Button">
        <Parent guid="guidSLCopilotCommandSet" id="EditorContextGroup" />
        <Strings><ButtonText>SLCopilot: 解释所选代码</ButtonText></Strings>
      </Button>
      <Button guid="guidSLCopilotCommandSet" id="cmdidFixErrors" priority="0x0102" type="Button">
        <Parent guid="guidSLCopilotCommandSet" id="EditorContextGroup" />
        <Strings><ButtonText>SLCopilot: 修复此处的错误</ButtonText></Strings>
      </Button>
      <Button guid="guidSLCopilotCommandSet" id="cmdidDiagnostics" priority="0x0104" type="Button">
        <Parent guid="guidSLCopilotCommandSet" id="ToolsMenuGroup" />
        <Strings><ButtonText>SLCopilot: 诊断</ButtonText></Strings>
      </Button>
      <Button guid="guidSLCopilotCommandSet" id="cmdidAnalyzeDebug" priority="0x0104" type="Button">
        <Parent guid="guidSLCopilotCommandSet" id="EditorContextGroup" />
        <Strings><ButtonText>SLCopilot: 分析当前异常 / 中断</ButtonText></Strings>
      </Button>
    </Buttons>
  </Commands>
  <CommandPlacements>
