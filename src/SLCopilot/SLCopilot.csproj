<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <!-- 传统 VSSDK 进程内扩展：由 VSIXInstaller 直接安装，不经过 Visual Studio Installer。 -->
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <Version>0.8.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RootNamespace>SLCopilot</RootNamespace>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <RegisterWithCodebase>true</RegisterWithCodebase>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>true</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <StartAction>Program</StartAction>
    <StartProgram>$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/rootsuffix Exp</StartArguments>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2094" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" />
    <!-- Roslyn 的 VS 集成（VisualStudioWorkspace）。只用于编译，运行时使用 VS 自带的同名程序集；版本取 VS 17.12 对应的 4.12，17.14 及以上兼容。 -->
    <PackageReference Include="Microsoft.VisualStudio.LanguageServices" Version="4.12.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <ProjectReference Include="../SLCopilot.Core/SLCopilot.Core.csproj" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Design" />
    <Reference Include="System.ComponentModel.Composition" />
    <Using Include="System.Net.Http" />
    <!-- UseWPF 的隐式 using 不含 System.IO（与 System.Windows.Shapes.Path 冲突）；本项目不使用 Shapes。 -->
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <None Include="source.extension.vsixmanifest" SubType="Designer" />
    <Content Include="../../LICENSE" Link="LICENSE">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <VSCTCompile Include="SLCopilotPackage.vsct" ResourceName="Menus.ctmenu" />
    <!-- Visual Studio 自带这些程序集，VSIX 中不重复打包。 -->
    <SuppressFromVsix Include="System.Text.Json.dll;Microsoft.Bcl.AsyncInterfaces.dll;System.Memory.dll;System.Buffers.dll;System.Numerics.Vectors.dll;System.Runtime.CompilerServices.Unsafe.dll;System.Text.Encodings.Web.dll;System.Threading.Tasks.Extensions.dll;System.ValueTuple.dll;System.IO.Pipelines.dll" />
  </ItemGroup>
  <!-- IncludeDebugSymbolsInVSIXContainer only controls this project's symbols. -->
  <Target Name="ExcludeReferencedDebugSymbolsFromVsix" AfterTargets="GetVsixSourceItems"
          Condition="'$(IncludeDebugSymbolsInVSIXContainer)' != 'true'">
    <ItemGroup>
      <VSIXSourceItem Remove="@(VSIXSourceItem)" Condition="'%(VSIXSourceItem.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="Exists('$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets')" />
</Project>
