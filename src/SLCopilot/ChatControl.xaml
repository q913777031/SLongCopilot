<UserControl x:Class="SLCopilot.ChatControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SLCopilot"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:vsui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
             Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
             FontSize="13">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible"/>
    <SolidColorBrush x:Key="Subtle" Color="#808080" Opacity="0.12"/>
    <SolidColorBrush x:Key="Hairline" Color="#808080" Opacity="0.35"/>
    <SolidColorBrush x:Key="Accent" Color="#2F6FDB"/>
    <SolidColorBrush x:Key="UserBubble" Color="#2F6FDB" Opacity="0.22"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#E5534B"/>
    <SolidColorBrush x:Key="AddedBrush" Color="#3FB950"/>
    <SolidColorBrush x:Key="DimText" Color="#8C8C8C"/>
    <SolidColorBrush x:Key="AddedBack" Color="#3FB950" Opacity="0.18"/>
    <SolidColorBrush x:Key="RemovedBack" Color="#E5534B" Opacity="0.18"/>
    <SolidColorBrush x:Key="ChangedWords" Color="#808080" Opacity="0.35"/>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Opacity" Value="0.7"/>
      <Setter Property="Margin" Value="0,8,0,2"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}">
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="MinWidth" Value="0"/>
    </Style>
    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="14,4"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{StaticResource Accent}" CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#3D7FEA"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- 输入区的模式与模型选择器：无边框，悬停时显示底色，与 Copilot 输入区一致。 -->
    <Style x:Key="Picker" TargetType="ComboBox" BasedOn="{StaticResource {x:Static vsshell:VsResourceKeys.ComboBoxStyleKey}}">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="4,2"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- 只在下拉列表中显示说明；选中框内（不在 ComboBoxItem 中）绑定失败，回退为折叠。 -->
    <Style x:Key="PickerHint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Opacity" Value="0.7"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="MaxWidth" Value="260"/>
      <Setter Property="Visibility" Value="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}, Converter={x:Static local:NotNullToVisibilityConverter.Instance}, FallbackValue=Collapsed}"/>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Static vsshell:VsResourceKeys.TextBoxStyleKey}}">
      <Setter Property="Padding" Value="4,3"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Expander">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <DockPanel>
              <ToggleButton DockPanel.Dock="Top" Content="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}"
                            IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Cursor="Hand">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Padding="0,5">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="Glyph" Text="▸" Width="16" Opacity="0.7"/>
                        <ContentPresenter TextElement.FontWeight="SemiBold"/>
                      </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Glyph" Property="Text" Value="▾"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter x:Name="Body" Visibility="Collapsed" Margin="16,2,0,6"/>
            </DockPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Toggle" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Chrome" Background="Transparent" BorderBrush="{StaticResource Hairline}" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource Subtle}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Subtle}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 命令与文件提示列表：透明背景，键盘选中的一项（↑ / ↓）加底色。 -->
    <Style x:Key="SuggestionList" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Chrome" Background="Transparent" CornerRadius="3"><ContentPresenter/></Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource Subtle}"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate DataType="{x:Type local:MarkdownPart}">
      <local:MarkdownView Blocks="{Binding Blocks}"
                          InsertCodeCommand="{Binding DataContext.InsertCodeCommand, RelativeSource={RelativeSource AncestorType=local:ChatControl}}"
                          OpenReferenceCommand="{Binding DataContext.OpenReferenceCommand, RelativeSource={RelativeSource AncestorType=local:ChatControl}}"/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:ActivityPart}">
      <StackPanel Margin="0,0,0,3">
        <TextBlock x:Name="Line" Text="{Binding Text}" FontSize="11" Opacity="0.65" TextWrapping="Wrap">
          <TextBlock.InputBindings>
            <MouseBinding Gesture="LeftClick" Command="{Binding ToggleCommand}"/>
          </TextBlock.InputBindings>
        </TextBlock>
        <TextBox Text="{Binding Detail, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="11" MaxHeight="260" Margin="12,2,0,2"
                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="1" BorderBrush="{StaticResource Hairline}"
                 Background="Transparent" Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
                 Visibility="{Binding IsExpanded, Converter={StaticResource Visible}}"/>
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsError}" Value="True">
          <Setter TargetName="Line" Property="Foreground" Value="{StaticResource ErrorBrush}"/>
          <Setter TargetName="Line" Property="Opacity" Value="1"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding HasDetail}" Value="True">
          <Setter TargetName="Line" Property="Cursor" Value="Hand"/>
          <Setter TargetName="Line" Property="ToolTip" Value="点击展开 / 收起工具返回给模型的内容"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <!-- 无边框的整行按钮：悬停显示底色。用于“已修改文件”卡片。 -->
    <Style x:Key="RowButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="Transparent" Padding="10,4">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource Subtle}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- 折叠的连续工具记录：点击展开逐行显示。 -->
    <DataTemplate DataType="{x:Type local:ActivityGroupPart}">
      <StackPanel Margin="0,0,0,3">
        <TextBlock FontSize="11" Opacity="0.65" Cursor="Hand" ToolTip="点击展开 / 收起这些工具记录">
          <TextBlock.InputBindings>
            <MouseBinding Gesture="LeftClick" Command="{Binding ToggleCommand}"/>
          </TextBlock.InputBindings>
          <Run Text="{Binding Glyph, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Title, Mode=OneWay}"/>
        </TextBlock>
        <ItemsControl ItemsSource="{Binding Items}" Focusable="False" Margin="12,2,0,0"
                      Visibility="{Binding IsExpanded, Converter={StaticResource Visible}}"/>
      </StackPanel>
    </DataTemplate>
    <!-- 一次写入的内联差异：路径与增删行数，下方为带行号的差异行（新增绿底、删除红底）。 -->
    <DataTemplate DataType="{x:Type local:DiffPart}">
      <Border Margin="12,0,0,6" BorderThickness="1" BorderBrush="{StaticResource Hairline}" CornerRadius="4">
        <StackPanel>
          <Button Style="{StaticResource RowButton}" ToolTip="在编辑器中打开并定位到这处改动"
                  Command="{Binding DataContext.OpenReferenceCommand, RelativeSource={RelativeSource AncestorType=local:ChatControl}}" CommandParameter="{Binding Reference}">
            <TextBlock Margin="2,1" FontSize="11" TextTrimming="CharacterEllipsis">
              <Run Text="{Binding Path, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding Added, Mode=OneWay}" Foreground="{StaticResource AddedBrush}"/><Run Text=" "/><Run Text="{Binding Removed, Mode=OneWay}" Foreground="{StaticResource ErrorBrush}"/>
            </TextBlock>
          </Button>
          <ItemsControl ItemsSource="{Binding Lines}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border x:Name="Row">
                  <DockPanel>
                    <TextBlock x:Name="Sign" DockPanel.Dock="Left" Width="12" Text=" " FontFamily="Cascadia Mono, Consolas" FontSize="11"/>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Number}" Width="38" TextAlignment="Right" Margin="0,0,8,0" Opacity="0.5" FontFamily="Cascadia Mono, Consolas" FontSize="11"/>
                    <local:DiffLineView x:Name="Code" Line="{Binding}" ChangedBrush="{StaticResource ChangedWords}" FontFamily="Cascadia Mono, Consolas" FontSize="11" TextTrimming="CharacterEllipsis"/>
                  </DockPanel>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Kind}" Value="added">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource AddedBack}"/>
                    <Setter TargetName="Sign" Property="Text" Value="+"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Kind}" Value="removed">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource RemovedBack}"/>
                    <Setter TargetName="Sign" Property="Text" Value="−"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Kind}" Value="gap">
                    <Setter TargetName="Code" Property="Opacity" Value="0.5"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Style="{StaticResource RowButton}" Content="{Binding ExpandText}" Command="{Binding ExpandCommand}" FontSize="11"
                  Visibility="{Binding CanExpand, Converter={StaticResource Visible}}"/>
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:ChangedFilesPart}">
      <Border Margin="0,6,0,4" BorderThickness="1" BorderBrush="{StaticResource Hairline}" CornerRadius="6">
        <StackPanel>
          <DockPanel Margin="10,6">
            <TextBlock DockPanel.Dock="Right" FontSize="12">
              <Run Text="{Binding TotalAdded, Mode=OneWay}" Foreground="{StaticResource AddedBrush}"/><Run Text=" "/><Run Text="{Binding TotalRemoved, Mode=OneWay}" Foreground="{StaticResource ErrorBrush}"/>
            </TextBlock>
            <Button DockPanel.Dock="Right" Style="{StaticResource RowButton}" Content="撤销本次全部改动" FontSize="11" Margin="0,0,8,0" Padding="0"
                    Command="{Binding DataContext.UndoRunCommand, RelativeSource={RelativeSource AncestorType=local:ChatControl}}" CommandParameter="{Binding}"
                    Visibility="{Binding CanRestore, Converter={StaticResource Visible}}"
                    ToolTip="把这次运行改动的全部文件恢复到修改前（需确认；之后的运行也会一并撤销）。文件被你改过时不会覆盖。"/>
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"/>
          </DockPanel>
          <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource Hairline}"/>
          <ItemsControl ItemsSource="{Binding Visible}" Focusable="False" Margin="0,2">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource RowButton}" Content="↶" FontSize="12" ToolTip="把这个文件恢复到修改前（需确认）"
                        Command="{Binding DataContext.RestoreChangedFileCommand, RelativeSource={RelativeSource AncestorType=local:ChatControl}}" CommandParameter="{Binding}"
                        Visibility="{Binding Owner.CanRestore, Converter={StaticResource Visible}}"/>
                <Button Style="{StaticResource RowButton}" ToolTip="{Binding ToolTip}"
                        Command="{Binding DataContext.OpenChangedFileCommand, RelativeSource={RelativeSource AncestorType=local:ChatControl}}"
                        CommandParameter="{Binding}">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" FontSize="12" Margin="8,0,0,0">
                      <Run Text="{Binding Added, Mode=OneWay}" Foreground="{StaticResource AddedBrush}"/><Run Text=" "/><Run Text="{Binding Removed, Mode=OneWay}" Foreground="{StaticResource ErrorBrush}"/>
                    </TextBlock>
                    <TextBlock Text="‹›" Opacity="0.6" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock TextTrimming="CharacterEllipsis" FontSize="12">
                      <Run Text="{Binding Name, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Folder, Mode=OneWay}" FontSize="11" Foreground="{StaticResource DimText}"/><Run Text="  "/><Run Text="{Binding Note, Mode=OneWay}" FontSize="11" FontStyle="Italic" Foreground="{StaticResource DimText}"/>
                    </TextBlock>
                  </DockPanel>
                </Button>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Style="{StaticResource RowButton}" Content="{Binding ShowAllText}" Command="{Binding ShowAllCommand}" FontSize="12" Margin="0,0,0,2"
                  Visibility="{Binding CanShowAll, Converter={StaticResource Visible}}"/>
        </StackPanel>
      </Border>
    </DataTemplate>
    <!-- 用户气泡中的图片缩略图。 -->
    <DataTemplate DataType="{x:Type local:ImagesPart}">
      <ItemsControl ItemsSource="{Binding Images}" Focusable="False" Margin="0,4,0,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderThickness="1" BorderBrush="{StaticResource Hairline}" CornerRadius="4" Margin="0,0,6,6" ToolTip="{Binding Label}">
              <Image Source="{Binding Thumbnail}" Height="72" Stretch="Uniform"/>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:ChatEntry}">
      <Border x:Name="Bubble" Margin="0,6" CornerRadius="8">
        <StackPanel>
          <DockPanel Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Style="{StaticResource RowButton}" Content="复制" FontSize="11" Padding="0" Opacity="0.6"
                    Command="{Binding CopyCommand}" ToolTip="复制这条消息的文字（Markdown 原文，不含工具记录）"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource RowButton}" Content="↶ 回退到此前" FontSize="11" Padding="0" Opacity="0.75"
                    Command="{Binding RewindCommand}" Visibility="{Binding CanRewind, Converter={StaticResource Visible}}"
                    ToolTip="撤销这次提问及之后各次运行的文件改动，并把对话回退到这次提问之前（需确认；文件被你改过时不会覆盖）"/>
            <TextBlock x:Name="Header" Text="{Binding Header}" FontSize="11" FontWeight="SemiBold" Opacity="0.6" VerticalAlignment="Center"/>
          </DockPanel>
          <!-- 提问文字与流式输出：只读文本框，可选中复制。 -->
          <TextBox Text="{Binding PlainText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0"
                   Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
                   VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" local:WheelForwarding.Enabled="True"
                   Visibility="{Binding ShowPlain, Converter={StaticResource Visible}}"/>
          <ItemsControl ItemsSource="{Binding Parts}" Focusable="False"/>
          <TextBlock Text="思考中…" FontSize="12" Opacity="0.6" FontStyle="Italic" Margin="0,2,0,0"
                     Visibility="{Binding IsPending, Converter={StaticResource Visible}}"/>
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsUser}" Value="True">
          <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/>
          <Setter TargetName="Bubble" Property="Margin" Value="48,6,0,6"/>
          <Setter TargetName="Bubble" Property="Padding" Value="12,8"/>
          <Setter TargetName="Bubble" Property="Background" Value="{StaticResource UserBubble}"/>
          <Setter TargetName="Header" Property="HorizontalAlignment" Value="Right"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 顶栏 -->
    <Border Grid.Row="0" Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Hairline}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="新对话" Command="{Binding ClearCommand}"/>
          <ToggleButton Content="历史" IsChecked="{Binding ShowHistory, Mode=TwoWay}" Style="{StaticResource Toggle}" Margin="0,0,6,0"/>
          <ToggleButton Content="设置" IsChecked="{Binding ShowSettings, Mode=TwoWay}" Style="{StaticResource Toggle}"/>
        </StackPanel>
        <TextBlock Text="SLCopilot" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <!-- 历史对话 -->
    <Border Grid.Row="1" Padding="12,8" Background="{StaticResource Subtle}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Hairline}"
            Visibility="{Binding ShowHistory, Converter={StaticResource Visible}}">
      <StackPanel>
        <TextBlock Text="历史对话（最近 100 个，保存在本机）" FontSize="11" Opacity="0.7" Margin="0,0,0,4"/>
        <TextBlock Text="还没有保存的对话。" Opacity="0.6" Visibility="{Binding HasConversations, Converter={x:Static local:InverseVisibilityConverter.Instance}}"/>
        <ItemsControl ItemsSource="{Binding Conversations}" MaxHeight="240" Focusable="False">
          <ItemsControl.Template>
            <ControlTemplate TargetType="ItemsControl">
              <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
            </ControlTemplate>
          </ItemsControl.Template>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="0,1">
                <Button DockPanel.Dock="Right" Content="删除" FontSize="11" Padding="6,1" Margin="6,0,0,0"
                        Command="{Binding DataContext.DeleteConversationCommand, RelativeSource={RelativeSource AncestorType=local:ChatControl}}"
                        CommandParameter="{Binding Id}"/>
                <Button HorizontalContentAlignment="Left" Padding="8,3" Margin="0" BorderThickness="0" Background="Transparent" Cursor="Hand"
                        Command="{Binding DataContext.OpenConversationCommand, RelativeSource={RelativeSource AncestorType=local:ChatControl}}"
                        CommandParameter="{Binding Id}">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding UpdatedAt, StringFormat='{}{0:MM-dd HH:mm}'}" FontSize="11" Opacity="0.6" Margin="8,0,0,0"/>
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                  </DockPanel>
                </Button>
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- 设置 -->
    <Border Grid.Row="2" Padding="12,4,12,12" Background="{StaticResource Subtle}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Hairline}"
            Visibility="{Binding ShowSettings, Converter={StaticResource Visible}}" IsEnabled="{Binding IsBusy, Converter={x:Static local:InverseBooleanConverter.Instance}}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400">
      <StackPanel>
        <TextBlock Text="模型配置名称" Style="{StaticResource Caption}"/>
        <TextBox Text="{Binding ProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider, Mode=TwoWay}" Margin="0,8,0,0" ToolTip="服务商：OpenAI 兼容服务、Claude 或 DeepSeek"/>
        <TextBlock Text="API 地址（HTTPS，包含 /v1）" Style="{StaticResource Caption}"/>
        <TextBox Text="{Binding Endpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="模型 ID（可手填，或点“获取列表”后从下拉选择）" Style="{StaticResource Caption}"/>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="获取列表" Command="{Binding RefreshModelsCommand}" Margin="6,0,0,0"
                      IsEnabled="{Binding ModelsLoading, Converter={x:Static local:InverseBooleanConverter.Instance}}"
                      ToolTip="用当前地址和密钥向服务商查询可用模型"/>
              <ComboBox IsEditable="True" Text="{Binding Model, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ItemsSource="{Binding AvailableModels}"
                        Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ComboBoxStyleKey}}"/>
            </DockPanel>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Claude 推理强度（low … max，留空不启用）" Style="{StaticResource Caption}"/>
            <TextBox Text="{Binding Effort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
          </StackPanel>
        </Grid>
        <TextBlock Text="API 密钥（保存到 Windows 凭据管理器，不写入任何文件）" Style="{StaticResource Caption}"/>
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="清除" Command="{Binding ClearKeyCommand}" Margin="6,0,0,0"
                  IsEnabled="{Binding HasStoredKey}"/>
          <Button DockPanel.Dock="Right" Content="保存密钥" Click="OnSaveKeyClick" Margin="6,0,0,0"/>
          <PasswordBox x:Name="KeyBox" Padding="4,3" VerticalContentAlignment="Center"
                       Background="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBackgroundBrushKey}}"
                       Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
                       BorderBrush="{StaticResource Hairline}"/>
        </DockPanel>
        <TextBlock Text="{Binding KeyStatus}" FontSize="11" Opacity="0.7" Margin="0,2,0,0" TextWrapping="Wrap"/>
        <TextBlock Text="备用：环境变量名（未保存密钥时读取；留空表示不用环境变量）" Style="{StaticResource Caption}"/>
        <TextBox Text="{Binding KeyVariable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <CheckBox Content="自动批准智能体的改动、编译、测试与命令（关闭后逐次审批）" IsChecked="{Binding AutoApprove, Mode=TwoWay}" Margin="0,10,0,0"
                  ToolTip="开启（默认）时不再弹出审批面板，直接执行。写入仍校验文件版本、拒绝覆盖未保存的编辑，并备份，可用“撤销”或检查点恢复；命令仍只能执行白名单内的程序。工作区 MCP 配置的信任确认不受影响。"/>
        <CheckBox Content="智能体运行前自动保存工作区内未保存的文件" IsChecked="{Binding SaveBeforeAgentRun, Mode=TwoWay}" Margin="0,6,0,0"
                  ToolTip="开启（默认）时与 VS 编译前自动保存一致。编辑器中有未保存修改的文件不能被智能体修改；关闭后这些文件在运行中只读。"/>
        <CheckBox Content="启用行内补全（输入时显示灰字建议，Tab 接受）" IsChecked="{Binding InlineCompletions, Mode=TwoWay}" Margin="0,6,0,0"
                  ToolTip="开启后，停顿输入时会把光标前后约 8,000 字符的代码发送给当前模型配置。立即生效，对所有配置共用。"/>
        <TextBlock Text="补全模型 ID（留空使用上面的模型；建议填写快速、低成本的模型，保存配置后生效）" Style="{StaticResource Caption}"/>
        <ComboBox IsEditable="True" Text="{Binding CompletionModel, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ItemsSource="{Binding AvailableModels}"
                  Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ComboBoxStyleKey}}"/>
        <TextBlock Text="上下文窗口（tokens，按模型文档填写；最近一次请求超过它的 80% 时自动把较早的对话压缩为摘要，0 为关闭）" Style="{StaticResource Caption}"/>
        <TextBox Text="{Binding ContextWindow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="智能体单文件上限（KiB，整文件读取与修改的最大文件；更大的文件只能分段读取，最多 32 MiB）" Style="{StaticResource Caption}"/>
        <TextBox Text="{Binding MaxFileKiB, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
        <TextBlock Text="智能体每次运行最多回合数（5–100，默认 50；达到上限时改动与对话都保留，可点“继续”）" Style="{StaticResource Caption}"/>
        <TextBox Text="{Binding MaxTurns, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
        <TextBlock Text="智能体命令白名单（每行一条：“程序” 或 “程序 子命令”，如 dotnet test；每次执行仍需批准；清空则不能执行任何命令）" Style="{StaticResource Caption}"/>
        <TextBox Text="{Binding AllowedCommandsText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="NoWrap"
                 MinHeight="72" MaxHeight="160" VerticalScrollBarVisibility="Auto"
                 ToolTip="run_command 与 run_tests 只能执行这里列出的程序；“程序 子命令”只允许第一个参数等于该子命令。不经过 shell，只执行 PATH 中的 .exe（git 优先使用 VS 自带的 Git）。失去焦点时保存，下一次运行生效。"/>
        <TextBlock Text="Claude CLI 桥接（在输入区左下角选择“Claude CLI”模式即启动，与内置智能体二选一；只监听 127.0.0.1，需令牌。Claude CLI 经本机 MCP 调用上面的工作区工具，文件由 VS 进程读写，适用于透明加密的源码）" Style="{StaticResource Caption}"/>
        <CheckBox Content="允许 Claude CLI 写入、编译、测试与执行白名单命令（关闭后只提供只读工具）" IsChecked="{Binding Bridge.AllowWrites, Mode=TwoWay}" Margin="0,6,0,0"
                  ToolTip="修改后桥接重启，已连接的 Claude CLI 需在其中执行 /mcp 重新连接。"/>
        <TextBlock Text="桥接端口（1024–65535，修改后需按新端口重新注册）" Style="{StaticResource Caption}"/>
        <TextBox Text="{Binding Bridge.PortText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
        <TextBlock Text="{Binding Bridge.Status}" FontSize="11" Opacity="0.7" Margin="0,2,0,0" TextWrapping="Wrap"/>
        <TextBlock Text="1. 在命令行执行一次注册命令（含令牌，等同密码，不要外传）" Style="{StaticResource Caption}"/>
        <TextBox Text="{Binding Bridge.RegisterCommand, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"/>
        <TextBlock Text="2. 在解决方案目录中用此命令启动 Claude CLI（禁用会直接读写磁盘的内置工具，它们只能看到密文）" Style="{StaticResource Caption}"/>
        <TextBox Text="{Binding Bridge.LaunchCommand, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"/>
        <WrapPanel Margin="0,6,0,0">
          <Button Content="复制注册命令" Command="{Binding Bridge.CopyRegisterCommand}"/>
          <Button Content="复制启动命令" Command="{Binding Bridge.CopyLaunchCommand}"/>
          <Button Content="重新生成令牌" Command="{Binding Bridge.RegenerateTokenCommand}" ToolTip="旧令牌立即失效，已注册的 Claude CLI 需删除后用新命令重新注册。"/>
        </WrapPanel>
        <TextBlock Text="工作区目录（运行时自动使用当前解决方案目录）" Style="{StaticResource Caption}"/>
        <TextBox Text="{Binding WorkspaceRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <WrapPanel Margin="0,10,0,0">
          <Button Content="保存配置" Command="{Binding SaveCommand}"/>
          <Button Content="新增配置" Command="{Binding AddProfileCommand}" ToolTip="复制当前设置为一套新的模型配置。"/>
          <Button Content="删除配置" Command="{Binding RemoveProfileCommand}"/>
        </WrapPanel>
      </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- 对话 -->
    <Grid Grid.Row="3">
      <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,8,12,4"
                    ScrollChanged="OnScrollChanged">
        <ItemsControl x:Name="MessageList" ItemsSource="{Binding Messages}" Focusable="False"/>
      </ScrollViewer>
      <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16" IsHitTestVisible="False">
        <TextBlock Text="询问你的代码，或让智能体修改它。" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
        <TextBlock Text="左下角选择“智能体”模式即可修改文件（询问、计划模式只读）。改动先备份，可逐个文件恢复或整体回退。输入 / 查看命令，@ 引用文件，/help 查看快捷键。"
                   Opacity="0.6" Margin="0,6,0,0" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320"/>
      </StackPanel>
      <!-- 向上翻看时出现：回到最新消息并恢复自动跟随。 -->
      <Button x:Name="JumpToLatest" Content="↓ 最新" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,8" Padding="10,3"
              Style="{StaticResource Primary}" Visibility="Collapsed" Click="OnJumpToLatest" ToolTip="回到最新消息"/>
    </Grid>

    <!-- 审批 -->
    <Border Grid.Row="4" Margin="12,4" Padding="10" BorderThickness="2" BorderBrush="{StaticResource Accent}" CornerRadius="4" Background="{StaticResource Subtle}"
            Visibility="{Binding HasPendingWrite, Converter={StaticResource Visible}}">
      <StackPanel>
        <TextBlock Text="是否批准此改动？（自动批准已关闭，所以逐项询问；点“全部批准”或打开 ⚡ 自动批准后不再询问）" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding PendingWriteTitle}" FontWeight="SemiBold" Margin="0,2,0,6" TextWrapping="Wrap"/>
        <TextBox Text="{Binding PendingWriteDiff, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                 MinHeight="100" MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 Visibility="{Binding HasPendingDiffPart, Converter={x:Static local:InverseVisibilityConverter.Instance}}"/>
        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding HasPendingDiffPart, Converter={StaticResource Visible}}">
          <ContentControl Content="{Binding PendingDiffPart}" Focusable="False"/>
        </ScrollViewer>
        <WrapPanel Margin="0,8,0,0">
          <Button Content="批准" Command="{Binding ApproveWriteCommand}" Style="{StaticResource Primary}" Margin="0,0,6,0"/>
          <Button Content="全部批准（开启自动批准）" Command="{Binding ApproveAllCommand}" Margin="0,0,6,0"
                  ToolTip="批准这一项，并开启自动批准：之后的改动、编译、测试与命令直接执行，不再询问（写入仍校验版本、备份、可撤销）。可随时用输入区的 ⚡ 开关关闭。"/>
          <Button Content="{Binding AllowForRunText}" Command="{Binding AllowFileForRunCommand}" Margin="0,0,6,0"
                  Visibility="{Binding CanAllowForRun, Converter={StaticResource Visible}}"
                  ToolTip="批准这一次；本次智能体运行中对同一文件的后续写入（或同一 MCP 工具的后续调用）不再询问。文件写入仍校验版本与未保存修改，并照常备份、可撤销。运行结束即失效，不保存。删除、移动、命令与编译仍逐次批准。"/>
          <Button Content="拒绝" Command="{Binding RejectWriteCommand}"/>
          <Button Content="在差异窗口中审阅 / 编辑" Command="{Binding OpenDiffCommand}" Margin="12,0,0,0"
                  Visibility="{Binding CanOpenDiff, Converter={StaticResource Visible}}"
                  ToolTip="用 Visual Studio 差异窗口查看本次改动；可在右侧删改不想要的部分，点击“批准”时写入右侧内容。"/>
        </WrapPanel>
      </StackPanel>
    </Border>

    <!-- 智能体活动 -->
    <StackPanel Grid.Row="5" Margin="12,0">
      <Expander Header="智能体活动与改动文件">
        <StackPanel>
          <TextBox Text="{Binding AgentChanges, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="100" VerticalScrollBarVisibility="Auto"/>
          <TextBlock Text="活动日志" Style="{StaticResource Caption}"/>
          <TextBox Text="{Binding AgentLog, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="200" VerticalScrollBarVisibility="Auto"/>
          <TextBlock Text="改动预览（- 修改前 / + 修改后）" Style="{StaticResource Caption}"/>
          <TextBox Text="{Binding AgentDiff, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" MaxHeight="220"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
          <Button Content="撤销上次智能体运行" Command="{Binding UndoAgentCommand}" IsEnabled="{Binding CanUndo}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
          <TextBlock Text="检查点（本次 VS 会话中有写入的运行；恢复时从最新一次逆序撤销）" Style="{StaticResource Caption}"
                     Visibility="{Binding HasCheckpoints, Converter={StaticResource Visible}}"/>
          <ItemsControl ItemsSource="{Binding Checkpoints}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,1">
                  <Button DockPanel.Dock="Right" Content="恢复到此运行之前" FontSize="11" Padding="6,1" Margin="6,0,0,0"
                          Command="{Binding DataContext.RestoreCheckpointCommand, RelativeSource={RelativeSource AncestorType=local:ChatControl}}"
                          CommandParameter="{Binding}"/>
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Expander>
    </StackPanel>

    <!-- 输入区 -->
    <Border Grid.Row="6" Margin="12,6,12,4" Padding="8" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource Hairline}" Background="{StaticResource Subtle}">
      <StackPanel>
        <Border HorizontalAlignment="Left" Margin="0,0,0,6" Padding="6,2" CornerRadius="3" BorderThickness="1" BorderBrush="{StaticResource Hairline}"
                Visibility="{Binding HasAttachment, Converter={StaticResource Visible}}">
          <TextBlock FontSize="11"><Run Text="📎 "/><Run Text="{Binding AttachmentTitle, Mode=OneWay}"/></TextBlock>
        </Border>
        <!-- 待发送的图片：缩略图与移除按钮。 -->
        <ItemsControl ItemsSource="{Binding PendingImages}" Focusable="False" Margin="0,0,0,6"
                      Visibility="{Binding HasPendingImages, Converter={StaticResource Visible}}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,6,4" ToolTip="{Binding Label}">
                <Border BorderThickness="1" BorderBrush="{StaticResource Hairline}" CornerRadius="4">
                  <Image Source="{Binding Thumbnail}" Height="56" Stretch="Uniform"/>
                </Border>
                <Button Content="✕" Command="{Binding RemoveCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0"
                        Padding="4,0" FontSize="10" MinWidth="0" ToolTip="移除这张图片"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- 达到回合 / 工具调用上限后：在同一对话中继续。 -->
        <DockPanel Margin="0,0,0,6" LastChildFill="True" Visibility="{Binding CanContinue, Converter={StaticResource Visible}}">
          <Button DockPanel.Dock="Right" Content="▶ 继续" Command="{Binding ContinueCommand}" Style="{StaticResource Primary}" Margin="6,0,0,0"
                  ToolTip="在本对话中接着完成剩余部分（已完成的改动与对话都已保留）。"/>
          <TextBlock Text="运行已中断（停止、达到上限或连接中断），改动与对话都已保留。" FontSize="11" Opacity="0.75" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
        <!-- Claude CLI 模式：本窗口停用，与内置智能体互斥。 -->
        <TextBlock Margin="0,0,0,6" FontSize="11" Opacity="0.85" TextWrapping="Wrap" Visibility="{Binding IsCliMode, Converter={StaticResource Visible}}"
                   Text="Claude CLI 模式：代码由 Claude CLI 经桥接修改，本窗口的智能体、询问、计划与撤销已停用。在左下角选择其他模式即切回（会先等 Claude CLI 正在执行的操作结束）。桥接状态与注册命令见“设置”。"/>
        <!-- 计划模式完成后：在同一对话中以智能体模式执行计划。 -->
        <DockPanel Margin="0,0,0,6" LastChildFill="True" Visibility="{Binding CanExecutePlan, Converter={StaticResource Visible}}">
          <Button DockPanel.Dock="Right" Content="▶ 按此计划执行" Command="{Binding ExecutePlanCommand}" Style="{StaticResource Primary}" Margin="6,0,0,0"
                  ToolTip="在本对话中以智能体模式执行上面的计划（是否逐次批准取决于“自动批准”开关）。"/>
          <TextBlock Text="计划已给出。可直接执行，或继续提问修改计划。" FontSize="11" Opacity="0.75" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
        <!-- 文件补全：输入 @ 或 #file: 后列出匹配的工作区文件，点击（或 Tab 选第一个）插入引用。 -->
        <ListBox ItemsSource="{Binding FileSuggestions}" Margin="0,0,0,6" Focusable="False" SelectedIndex="{Binding SuggestionIndex, Mode=OneWay}"
                 Style="{StaticResource SuggestionList}"
                      Visibility="{Binding HasFileSuggestions, Converter={StaticResource Visible}}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Button HorizontalContentAlignment="Left" Padding="6,2" Margin="0,0,0,1" BorderThickness="0" Background="Transparent" Cursor="Hand" Focusable="False"
                      Command="{Binding DataContext.UseFileCommand, RelativeSource={RelativeSource AncestorType=local:ChatControl}}"
                      CommandParameter="{Binding}">
                <TextBlock TextTrimming="CharacterEllipsis"><Run Text="📄 "/><Run Text="{Binding Mode=OneWay}" Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"/></TextBlock>
              </Button>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <!-- 斜杠命令提示：输入“/”时列出匹配的命令，点击填入。 -->
        <ListBox ItemsSource="{Binding CommandSuggestions}" Margin="0,0,0,6" Focusable="False" SelectedIndex="{Binding SuggestionIndex, Mode=OneWay}"
                 Style="{StaticResource SuggestionList}"
                      Visibility="{Binding HasCommandSuggestions, Converter={StaticResource Visible}}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Button HorizontalContentAlignment="Left" Padding="6,2" Margin="0,0,0,1" BorderThickness="0" Background="Transparent" Cursor="Hand" Focusable="False"
                      Command="{Binding DataContext.UseCommandCommand, RelativeSource={RelativeSource AncestorType=local:ChatControl}}"
                      CommandParameter="{Binding Name}">
                <TextBlock TextWrapping="Wrap"><Run Text="/" FontWeight="SemiBold"/><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding Description, Mode=OneWay}" Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"/></TextBlock>
              </Button>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Grid IsEnabled="{Binding CanType}">
          <TextBox x:Name="PromptBox" Text="{Binding Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="56" MaxHeight="160"
                   AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"
                   Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" PreviewKeyDown="OnPromptKeyDown"
                   AllowDrop="True" PreviewDragOver="OnPromptDragOver" PreviewDrop="OnPromptDrop" GotKeyboardFocus="OnPromptFocused"/>
          <TextBlock x:Name="PromptHint" Text="提问，或描述要智能体完成的修改…  输入 / 查看命令，@ 引用文件，Ctrl+V 粘贴截图（Enter 发送，Shift+Enter 换行，↑ 找回上一条）"
                     Opacity="0.5" Margin="6,4,0,0" IsHitTestVisible="False" TextWrapping="Wrap"/>
        </Grid>
        <DockPanel Margin="2,4,0,0" Visibility="{Binding EditorHint, Converter={x:Static local:NotNullToVisibilityConverter.Instance}}">
          <Button DockPanel.Dock="Left" Content="✕" FontSize="10" Padding="4,0" Margin="0,0,4,0" MinWidth="0" BorderThickness="0" Background="Transparent" Cursor="Hand"
                  Command="{Binding SkipEditorContextCommand}" ToolTip="本次提问不附带编辑器上下文（发送后恢复）"/>
          <TextBlock Text="{Binding EditorHint}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                     ToolTip="发送时会附带最近活动编辑器的文件、光标行与选区（选区原文受工作区规则约束）"/>
        </DockPanel>
        <DockPanel Margin="0,6,0,0" LastChildFill="False">
          <Button x:Name="StopButton" DockPanel.Dock="Right" Content="■ 停止 (Esc)" Command="{Binding CancelCommand}" Margin="0"
                  Style="{StaticResource Primary}" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}"
                  ToolTip="停止当前请求或智能体运行。已完成的文件写入会保留，可在检查点中恢复。"/>
          <Button DockPanel.Dock="Right" Content="↪ 补充" Command="{Binding SteerCommand}" Margin="0,0,6,0" Padding="8,4"
                  Visibility="{Binding CanSteer, Converter={StaticResource Visible}}"
                  ToolTip="运行中也可以输入：把输入框中的补充要求在当前步骤完成后交给模型（Enter 同效），不必停止重来。"/>
          <TextBlock DockPanel.Dock="Right" Text="{Binding RunningText}" FontSize="11" Opacity="0.75" Margin="0,0,10,0" VerticalAlignment="Center"
                     Visibility="{Binding IsBusy, Converter={StaticResource Visible}}"/>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                      Visibility="{Binding IsBusy, Converter={x:Static local:InverseVisibilityConverter.Instance}}">
            <Button Content="🖼" Command="{Binding AttachImageCommand}" Padding="8,4"
                    ToolTip="附加图片（界面截图、报错弹窗等）。也可以在输入框中 Ctrl+V 粘贴截图，或把图片文件拖到输入框。每次最多 5 张。"/>
            <Button Content="发送" Command="{Binding SendCommand}" Style="{StaticResource Primary}"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" IsEnabled="{Binding IsBusy, Converter={x:Static local:InverseBooleanConverter.Instance}}">
            <ComboBox ItemsSource="{Binding Modes}" SelectedIndex="{Binding ModeIndex, Mode=TwoWay}" Style="{StaticResource Picker}" ToolTip="选择询问、智能体、计划或 Claude CLI 模式（Claude CLI 与其他模式二选一）">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,1">
                    <TextBlock><Run Text="{Binding Icon, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Name, Mode=OneWay}"/></TextBlock>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource PickerHint}"/>
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button x:Name="ModelButton" Click="OnModelButtonClick" Margin="4,0,0,0" Padding="6,2" BorderThickness="0" Background="Transparent"
                    Cursor="Hand" VerticalAlignment="Center" MaxWidth="240"
                    ToolTip="选择模型与思考强度（数字键 1–4 选择前四个模型）。在“设置”中新增或编辑服务配置。">
              <TextBlock TextTrimming="CharacterEllipsis"><Run Text="{Binding PickerLabel, Mode=OneWay}"/><Run Text=" ▾" FontSize="10"/></TextBlock>
            </Button>
            <ToggleButton IsChecked="{Binding AutoApprove, Mode=TwoWay}" Style="{StaticResource Toggle}" Margin="4,0,0,0" Padding="6,1" FontSize="11" VerticalAlignment="Center"
                          Content="⚡ 自动批准" ToolTip="开启时智能体的改动、编译、测试与命令直接执行（写入仍校验版本、备份、可撤销）；关闭后逐次审批。与“设置”中的开关相同。"/>
          </StackPanel>
        </DockPanel>
      </StackPanel>
    </Border>

    <!-- 状态 -->
    <DockPanel Grid.Row="7" Margin="14,0,14,8">
      <TextBlock DockPanel.Dock="Right" Text="{Binding UsageText}" FontSize="11" Opacity="0.6" Margin="12,0,0,0"
                 ToolTip="服务商返回的 token 用量：上下文为最近一次请求送入模型的大小；本次为这次提问（智能体为整次运行）的累计。"/>
      <TextBlock Text="{Binding Status}" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
    </DockPanel>
  </Grid>
</UserControl>
